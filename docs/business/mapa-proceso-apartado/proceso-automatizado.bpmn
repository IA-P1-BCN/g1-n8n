<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_auto" targetNamespace="http://bpmn.io/schema/bpmn" exporter="paso-firme · generador bpmn" exporterVersion="1">
  <collaboration id="collab_auto">
    <participant id="pool_auto" name="Zapatería Paso Firme · proceso automatizado con n8n" processRef="proc_auto"/>
  </collaboration>
  <process id="proc_auto" isExecutable="false">
    <laneSet id="lanes_auto">
      <lane id="lane_auto_0" name="Marisa (dueña)" flowNodeRef="t_app_apartado t_app_abono"/>
      <lane id="lane_auto_1" name="Cliente" flowNodeRef="st_cliente t_pago"/>
      <lane id="lane_auto_2" name="App de la tienda" flowNodeRef="a_guarda a_webhook a_abono a_webhook2"/>
      <lane id="lane_auto_3" name="n8n" flowNodeRef="n_recep st_err f08 e_f08 f01 g_email m_email e_conf m_aviso e_aviso f02 g_liquida m_final e_final m_parcial e_parcial"/>
      </laneSet>
    <userTask id="t_app_apartado" name="Registrar el apartado en la app (abono inicial ≥ 5 €)"/>
    <userTask id="t_app_abono" name="Registrar el abono en la app"/>
    <startEvent id="st_cliente" name="Cliente quiere apartar un par"/>
    <task id="t_pago" name="Paga en tienda, o Bizum/transferencia (aviso del banco)"/>
    <serviceTask id="a_guarda" name="Valida y guarda el apartado (activo, pendiente, fecha límite 90 días)"/>
    <sendTask id="a_webhook" name="Avisa a n8n: POST /webhook/tienda — evento apartado.creado"/>
    <serviceTask id="a_abono" name="Valida el abono (no supera lo pendiente) y actualiza (parcial o liquidado)"/>
    <sendTask id="a_webhook2" name="Avisa a n8n: POST abono.registrado"/>
    <task id="n_recep" name="Receptor · Webhook tienda: Evento y datos, Repartir por evento"/>
    <startEvent id="st_err" name="Fallo de un flujo (SMTP u otro)"><errorEventDefinition/></startEvent>
    <task id="f08" name="Flujo 08 · Aviso de fallo"/>
    <endEvent id="e_f08" name="Email de aviso a la tienda"/>
    <task id="f01" name="Flujo 01 · Confirmación de apartado"/>
    <exclusiveGateway id="g_email" name="¿El cliente tiene email?"/>
    <sendTask id="m_email" name="Email de confirmación (producto, importes, fecha límite)"/>
    <endEvent id="e_conf" name="Cliente confirmado por email"/>
    <sendTask id="m_aviso" name="Email de aviso a la tienda (sin email)"/>
    <endEvent id="e_aviso" name="La tienda contacta al cliente"/>
    <task id="f02" name="Flujo 02 · Recibo de cada abono"/>
    <exclusiveGateway id="g_liquida" name="¿El abono lo liquida?"/>
    <sendTask id="m_final" name="Email de recibo final (par listo para recoger)"/>
    <endEvent id="e_final" name="Recibo final enviado"/>
    <sendTask id="m_parcial" name="Email de recibo parcial (queda por abonar)"/>
    <endEvent id="e_parcial" name="Recibo parcial enviado"/>
    <sequenceFlow id="f1" sourceRef="st_cliente" targetRef="t_app_apartado"/>
    <sequenceFlow id="f2" sourceRef="t_app_apartado" targetRef="a_guarda"/>
    <sequenceFlow id="f3" sourceRef="a_guarda" targetRef="a_webhook"/>
    <sequenceFlow id="f4" sourceRef="a_webhook" targetRef="n_recep"/>
    <sequenceFlow id="f5" sourceRef="n_recep" targetRef="f01"/>
    <sequenceFlow id="f6" sourceRef="f01" targetRef="g_email"/>
    <sequenceFlow id="f7" name="Sí" sourceRef="g_email" targetRef="m_email"/>
    <sequenceFlow id="f8" sourceRef="m_email" targetRef="e_conf"/>
    <sequenceFlow id="f9" name="No · sin email" sourceRef="g_email" targetRef="m_aviso"/>
    <sequenceFlow id="f10" sourceRef="m_aviso" targetRef="e_aviso"/>
    <sequenceFlow id="f11" sourceRef="t_pago" targetRef="t_app_abono"/>
    <sequenceFlow id="f12" sourceRef="t_app_abono" targetRef="a_abono"/>
    <sequenceFlow id="f13" sourceRef="a_abono" targetRef="a_webhook2"/>
    <sequenceFlow id="f14" sourceRef="a_webhook2" targetRef="n_recep"/>
    <sequenceFlow id="f15" sourceRef="n_recep" targetRef="f02"/>
    <sequenceFlow id="f16" sourceRef="f02" targetRef="g_liquida"/>
    <sequenceFlow id="f17" name="Sí · liquidado" sourceRef="g_liquida" targetRef="m_final"/>
    <sequenceFlow id="f18" sourceRef="m_final" targetRef="e_final"/>
    <sequenceFlow id="f19" name="No · recibo parcial" sourceRef="g_liquida" targetRef="m_parcial"/>
    <sequenceFlow id="f20" sourceRef="m_parcial" targetRef="e_parcial"/>
    <sequenceFlow id="f21" sourceRef="st_err" targetRef="f08"/>
    <sequenceFlow id="f22" sourceRef="f08" targetRef="e_f08"/>
    <textAnnotation id="nt_err">
      <text>El Flujo 08 se dispara desde el ajuste errorWorkflow de los demás flujos; no se apunta a sí mismo.</text>
    </textAnnotation>
    <association id="assoc_nt_err" sourceRef="f08" targetRef="nt_err"/>
    <textAnnotation id="nt_recep">
      <text>El Switch «Repartir por evento» también tiene salidas venta.registrada (Flujo 04, US-09) y apartado.vencido (Flujo 06, US-07): aún sin conectar.</text>
    </textAnnotation>
    <association id="assoc_nt_recep" sourceRef="n_recep" targetRef="nt_recep"/>
    <textAnnotation id="nt_pago">
      <text>A día de hoy los Bizum/transferencia se revisan a mano; el flujo de abonos a distancia queda pendiente (nivel medio).</text>
    </textAnnotation>
    <association id="assoc_nt_pago" sourceRef="t_pago" targetRef="nt_pago"/>
  </process>
  <bpmndi:BPMNDiagram id="diagrama">
    <bpmndi:BPMNPlane id="plano" bpmnElement="collab_auto">
    <bpmndi:BPMNShape id="shape_pool" bpmnElement="pool_auto" isHorizontal="true"><dc:Bounds x="140" y="60" width="1980" height="940"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="shape_lane_0" bpmnElement="lane_auto_0" isHorizontal="true"><dc:Bounds x="140" y="60" width="1980" height="200"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="shape_lane_1" bpmnElement="lane_auto_1" isHorizontal="true"><dc:Bounds x="140" y="260" width="1980" height="140"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="shape_lane_2" bpmnElement="lane_auto_2" isHorizontal="true"><dc:Bounds x="140" y="400" width="1980" height="200"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="shape_lane_3" bpmnElement="lane_auto_3" isHorizontal="true"><dc:Bounds x="140" y="600" width="1980" height="400"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="sh_t_app_apartado" bpmnElement="t_app_apartado"><dc:Bounds x="350" y="120" width="110" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="sh_t_app_abono" bpmnElement="t_app_abono"><dc:Bounds x="1070" y="120" width="110" height="80"/></bpmndi:BPMNShape>

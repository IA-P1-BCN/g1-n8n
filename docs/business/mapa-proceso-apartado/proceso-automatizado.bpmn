    <bpmndi:BPMNShape id="sh_n_recep" bpmnElement="n_recep"><dc:Bounds x="950" y="640" width="110" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="sh_st_err" bpmnElement="st_err"><dc:Bounds x="640" y="672" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="sh_f08" bpmnElement="f08"><dc:Bounds x="750" y="650" width="110" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="sh_e_f08" bpmnElement="e_f08"><dc:Bounds x="880" y="672" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="sh_f01" bpmnElement="f01"><dc:Bounds x="1230" y="640" width="110" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="sh_g_email" bpmnElement="g_email"><dc:Bounds x="1420" y="655" width="50" height="50"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="sh_m_email" bpmnElement="m_email"><dc:Bounds x="1550" y="610" width="110" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="sh_e_conf" bpmnElement="e_conf"><dc:Bounds x="1750" y="624" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="sh_m_aviso" bpmnElement="m_aviso"><dc:Bounds x="1550" y="740" width="110" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="sh_e_aviso" bpmnElement="e_aviso"><dc:Bounds x="1750" y="754" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="sh_f02" bpmnElement="f02"><dc:Bounds x="1230" y="830" width="110" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="sh_g_liquida" bpmnElement="g_liquida"><dc:Bounds x="1420" y="845" width="50" height="50"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="sh_m_final" bpmnElement="m_final"><dc:Bounds x="1550" y="810" width="110" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="sh_e_final" bpmnElement="e_final"><dc:Bounds x="1750" y="832" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="sh_m_parcial" bpmnElement="m_parcial"><dc:Bounds x="1550" y="920" width="110" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="sh_e_parcial" bpmnElement="e_parcial"><dc:Bounds x="1750" y="942" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="ed_f1" bpmnElement="f1"><di:waypoint x="246" y="335"/> <di:waypoint x="300" y="335"/> <di:waypoint x="300" y="160"/> <di:waypoint x="350" y="160"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="ed_f2" bpmnElement="f2"><di:waypoint x="460" y="160"/> <di:waypoint x="520" y="160"/> <di:waypoint x="520" y="460"/> <di:waypoint x="550" y="460"/></bpmndi:BPMNEdge>

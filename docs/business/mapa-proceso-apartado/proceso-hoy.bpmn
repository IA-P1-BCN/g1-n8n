<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_hoy" targetNamespace="http://bpmn.io/schema/bpmn" exporter="paso-firme · generador bpmn" exporterVersion="1">
  <collaboration id="collab_hoy">
    <participant id="pool_hoy" name="Zapatería Paso Firme · proceso actual, íntegramente a mano" processRef="proc_hoy"/>
  </collaboration>
  <process id="proc_hoy" isExecutable="false">
    <laneSet id="lanes_hoy">
      <lane id="lane_hoy_0" name="Marisa (dueña)" flowNodeRef="t_libreta t_calcular t_avisar t_pagobanco g_valida t_excel g_cero t_entregar e_lqd t_preguntar st_diario t_repaso t_vencido e_vencido st_cierre t_dia t_mes e_cifras"/>
      <lane id="lane_hoy_1" name="Cliente" flowNodeRef="st_cliente t_pago"/>
      </laneSet>
    <startEvent id="st_cliente" name="Cliente quiere apartar un par"/>
    <task id="t_pago" name="Paga el apartado y su abono (en tienda o Bizum/transferencia)"/>
    <task id="t_libreta" name="Apuntar en la libreta: cliente, producto, talla y abono (mín 5 €)"/>
    <manualTask id="t_calcular" name="Calcular pendiente y fecha límite (90 días) con la calculadora"/>
    <sendTask id="t_avisar" name="Avisar al cliente a mano (llamada o WhatsApp)"/>
    <task id="t_pagobanco" name="Localizar el pago en la libreta y el Excel"/>
    <exclusiveGateway id="g_valida" name="¿Coincide el pago?"/>
    <task id="t_excel" name="Apuntar el abono en el Excel y recalcular pendiente"/>
    <exclusiveGateway id="g_cero" name="¿Pendiente = 0 €?"/>
    <manualTask id="t_entregar" name="Entregar el par y liquidar el apartado"/>
    <endEvent id="e_lqd" name="Apartado liquidado"/>
    <manualTask id="t_preguntar" name="Buscar y preguntar a mano (nombre abreviado, pago sin concepto…)"/>
    <startEvent id="st_diario" name="Cada día"><timerEventDefinition/></startEvent>
    <task id="t_repaso" name="Repasar vencimientos: apartados con más de 90 días"/>
    <task id="t_vencido" name="Deshacer el apartado: zapatos a la venta y vale de compra"/>
    <endEvent id="e_vencido" name="Apartado vencido · vale para el cliente"/>
    <startEvent id="st_cierre" name="Fin del día / fin de mes"><timerEventDefinition/></startEvent>
    <task id="t_dia" name="Sumar a mano las ventas y cobros del día"/>
    <task id="t_mes" name="Sumar a mano la recaudación del mes"/>
    <endEvent id="e_cifras" name="Cifras del día y del mes (a mano)"/>
    <sequenceFlow id="f1" sourceRef="st_cliente" targetRef="t_libreta"/>
    <sequenceFlow id="f2" sourceRef="t_libreta" targetRef="t_calcular"/>
    <sequenceFlow id="f3" sourceRef="t_calcular" targetRef="t_avisar"/>
    <sequenceFlow id="f4" sourceRef="t_avisar" targetRef="t_pago"/>
    <sequenceFlow id="f5" sourceRef="t_pago" targetRef="t_pagobanco"/>
    <sequenceFlow id="f6" sourceRef="t_pagobanco" targetRef="g_valida"/>
    <sequenceFlow id="f7" name="Sí" sourceRef="g_valida" targetRef="t_excel"/>
    <sequenceFlow id="f8" name="No" sourceRef="g_valida" targetRef="t_preguntar"/>
    <sequenceFlow id="f9" name="Revisa el pago otra vez" sourceRef="t_preguntar" targetRef="g_valida"/>
    <sequenceFlow id="f10" sourceRef="t_excel" targetRef="g_cero"/>
    <sequenceFlow id="f11" name="Sí · liquidado" sourceRef="g_cero" targetRef="t_entregar"/>
    <sequenceFlow id="f12" name="No · espera el siguiente abono" sourceRef="g_cero" targetRef="t_pagobanco"/>
    <sequenceFlow id="f13" sourceRef="t_entregar" targetRef="e_lqd"/>
    <sequenceFlow id="f14" sourceRef="st_diario" targetRef="t_repaso"/>
    <sequenceFlow id="f15" sourceRef="t_repaso" targetRef="t_vencido"/>
    <sequenceFlow id="f16" sourceRef="t_vencido" targetRef="e_vencido"/>
    <sequenceFlow id="f17" sourceRef="st_cierre" targetRef="t_dia"/>
    <sequenceFlow id="f18" sourceRef="t_dia" targetRef="t_mes"/>
    <sequenceFlow id="f19" sourceRef="t_mes" targetRef="e_cifras"/>
    <textAnnotation id="nt_diario">
      <text>Papel, post-its y memoria: si se salta un día, un apartado vence sin que nadie lo vea.</text>
    </textAnnotation>
    <association id="assoc_nt_diario" sourceRef="t_repaso" targetRef="nt_diario"/>
  </process>
  <bpmndi:BPMNDiagram id="diagrama">
    <bpmndi:BPMNPlane id="plano" bpmnElement="collab_hoy">
    <bpmndi:BPMNShape id="shape_pool" bpmnElement="pool_hoy" isHorizontal="true"><dc:Bounds x="140" y="60" width="1980" height="510"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="shape_lane_0" bpmnElement="lane_hoy_0" isHorizontal="true"><dc:Bounds x="140" y="60" width="1980" height="380"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="shape_lane_1" bpmnElement="lane_hoy_1" isHorizontal="true"><dc:Bounds x="140" y="440" width="1980" height="130"/></bpmndi:BPMNShape>

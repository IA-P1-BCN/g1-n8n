    <bpmndi:BPMNShape id="sh_nt_diario" bpmnElement="nt_diario"><dc:Bounds x="960" y="358" width="300" height="40"/><bpmndi:BPMNLabel/></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="ed_assoc_nt_diario" bpmnElement="assoc_nt_diario"><di:waypoint x="1110" y="358"/><di:waypoint x="485" y="330"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

    <bpmndi:BPMNShape id="sh_t_pagobanco" bpmnElement="t_pagobanco"><dc:Bounds x="1100" y="140" width="110" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="sh_g_valida" bpmnElement="g_valida"><dc:Bounds x="1310" y="155" width="50" height="50"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="sh_t_excel" bpmnElement="t_excel"><dc:Bounds x="1450" y="140" width="110" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="sh_g_cero" bpmnElement="g_cero"><dc:Bounds x="1650" y="155" width="50" height="50"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="sh_t_entregar" bpmnElement="t_entregar"><dc:Bounds x="1790" y="140" width="110" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="sh_e_lqd" bpmnElement="e_lqd"><dc:Bounds x="2010" y="162" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="sh_t_preguntar" bpmnElement="t_preguntar"><dc:Bounds x="1240" y="250" width="110" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="sh_st_diario" bpmnElement="st_diario"><dc:Bounds x="330" y="272" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="sh_t_repaso" bpmnElement="t_repaso"><dc:Bounds x="430" y="250" width="110" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="sh_t_vencido" bpmnElement="t_vencido"><dc:Bounds x="660" y="250" width="110" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="sh_e_vencido" bpmnElement="e_vencido"><dc:Bounds x="830" y="272" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="sh_st_cierre" bpmnElement="st_cierre"><dc:Bounds x="330" y="372" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="sh_t_dia" bpmnElement="t_dia"><dc:Bounds x="430" y="350" width="110" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="sh_t_mes" bpmnElement="t_mes"><dc:Bounds x="660" y="350" width="110" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="sh_e_cifras" bpmnElement="e_cifras"><dc:Bounds x="830" y="372" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="ed_f1" bpmnElement="f1"><di:waypoint x="246" y="505"/> <di:waypoint x="300" y="505"/> <di:waypoint x="300" y="180"/> <di:waypoint x="330" y="180"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="ed_f2" bpmnElement="f2"><di:waypoint x="440" y="180"/> <di:waypoint x="550" y="180"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="ed_f3" bpmnElement="f3"><di:waypoint x="660" y="180"/> <di:waypoint x="770" y="180"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="ed_f4" bpmnElement="f4"><di:waypoint x="880" y="180"/> <di:waypoint x="900" y="180"/> <di:waypoint x="900" y="505"/> <di:waypoint x="930" y="505"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="ed_f5" bpmnElement="f5"><di:waypoint x="1040" y="505"/> <di:waypoint x="1070" y="505"/> <di:waypoint x="1070" y="180"/> <di:waypoint x="1100" y="180"/></bpmndi:BPMNEdge>

{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "n8n-mcp": {
      "type": "local",
      "command": ["cmd", "/c", "n8n-mcp"],
      "enabled": true,
      "environment": {
        "MCP_MODE": "stdio",
        "LOG_LEVEL": "error",
        "DISABLE_CONSOLE_OUTPUT": "true",
        "N8N_API_URL": "http://localhost:5678",
        "WEBHOOK_SECURITY_MODE": "moderate"
      }
    }
  }
}

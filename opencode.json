{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "n8n-mcp": {
        "type": "local",
        "command": ["npx", "-y", "n8n-mcp"],
        "environment": {
          "MCP_MODE": "stdio",
          "LOG_LEVEL": "error",
          "DISABLE_CONSOLE_OUTPUT": "true",
          "N8N_API_URL": "http://localhost:5678",
          "WEBHOOK_SECURITY_MODE": "moderate",
          "N8N_API_KEY": "{env:N8N_API_KEY}"
        }
      }
    }
  }
}
